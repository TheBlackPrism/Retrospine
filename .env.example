# Postgres connection string. docker-compose sets this for you.
DATABASE_URL=postgres://retrospine:retrospine@localhost:5432/retrospine

# Secret used to sign sessions and to encrypt stored OIDC client secrets.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Public URL the app is reached at. Used for OIDC redirect URIs and secure cookies.
BETTER_AUTH_URL=http://localhost:3000

# Optional. A Google Books API key raises the daily request quota.
GOOGLE_BOOKS_API_KEY=

# Optional. ISO 3166-1 country code sent with Google Books requests (default: US).
# Google answers 503 "Service temporarily unavailable" for IP ranges it cannot
# geolocate, which an explicit country avoids. Set it to your own country if you like.
GOOGLE_BOOKS_COUNTRY=

# Run pending database migrations when the server starts (default: true).
AUTO_MIGRATE=true
